{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node -e \"const fs=require('fs');const p='node_modules/.bin';try{fs.readdirSync(p).forEach(f=>fs.chmodSync(p+'/'+f,0o755))}catch(e){}\" && npx vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install --include=optional --foreground-scripts",
  "framework": "vite"
}
